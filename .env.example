# ZYNDRIX ENVIRONMENT TEMPLATE
# Copy to .env.local for development

# --- SUPABASE (Infrastructure) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-DO-NOT-EXPOSE

# --- EXTERNAL APIS (Intelligence & Generation) ---
GOOGLE_MAPS_API_KEY=your-google-maps-key
ANTHROPIC_API_KEY=your-claude-key
RESEND_API_KEY=your-resend-key
STITCH_API_KEY=your-stitch-key

# --- SYSTEM CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DAEMON_SCAN_INTERVAL_MIN=30
MAX_LEADS_PER_SCAN=20
DEBUG=false
