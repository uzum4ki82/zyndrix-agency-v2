{
  "name": "LinkedIn Post TEST - Zyndrix",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "linkedin-post-test",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-linkedin-001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "linkedin-post-test"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst postText = body.text || body.texto || 'Test Zyndrix';\nconst bearerToken = body.token || body.access_token || '';\nconst visibility = body.visibility || 'PUBLIC';\nconsole.log('Token recibido:', bearerToken ? bearerToken.substring(0,20) + '...' : 'VACIO');\nreturn [{ json: { postText: postText.trim(), bearerToken, visibility } }];"
      },
      "id": "extract-params-001",
      "name": "Extract Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.linkedin.com/v2/userinfo",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $json.bearerToken }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "get-profile-001",
      "name": "Get LinkedIn Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst data = d.body || d;\nconsole.log('Respuesta LinkedIn userinfo:', JSON.stringify(data).substring(0, 200));\nconst personId = data.sub;\nif (!personId) {\n  throw new Error('No personId. Respuesta: ' + JSON.stringify(data));\n}\nconst params = $('Extract Params').first().json;\nreturn [{ json: { personId, postText: params.postText, visibility: params.visibility, bearerToken: params.bearerToken } }];"
      },
      "id": "get-person-id-001",
      "name": "Get Person ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const { personId, postText, visibility, bearerToken } = $input.first().json;\nconst ugcBody = {\n  author: `urn:li:person:${personId}`,\n  lifecycleState: 'PUBLISHED',\n  specificContent: {\n    'com.linkedin.ugc.ShareContent': {\n      shareCommentary: { text: postText },\n      shareMediaCategory: 'NONE'\n    }\n  },\n  visibility: { 'com.linkedin.ugc.MemberNetworkVisibility': visibility }\n};\nconsole.log('UGC Body:', JSON.stringify(ugcBody));\nreturn [{ json: { ugcBodyStr: JSON.stringify(ugcBody), personId, bearerToken } }];"
      },
      "id": "build-body-001",
      "name": "Build UGC Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $json.bearerToken }}"
            },
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.ugcBodyStr }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "post-linkedin-001",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst statusCode = d.statusCode;\nconst body = d.body || d;\nif (statusCode === 201 || statusCode === 200) {\n  return [{ json: { success: true, postId: d.headers?.['x-restli-id'] || 'ok', statusCode } }];\n}\nconst errores = {\n  401: 'Token inválido o expirado',\n  403: 'Sin permiso w_member_social en tu LinkedIn App',\n  422: 'Body mal formateado o personId incorrecto',\n  429: 'Rate limit de LinkedIn'\n};\nreturn [{ json: { success: false, statusCode, error: body, diagnostico: errores[statusCode] || 'Error desconocido' } }];"
      },
      "id": "check-result-001",
      "name": "Check Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": { "responseCode": "={{ $json.success ? 200 : 400 }}" }
      },
      "id": "respond-001",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1680, 0]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Extract Params", "type": "main", "index": 0 }]] },
    "Extract Params": { "main": [[{ "node": "Get LinkedIn Profile", "type": "main", "index": 0 }]] },
    "Get LinkedIn Profile": { "main": [[{ "node": "Get Person ID", "type": "main", "index": 0 }]] },
    "Get Person ID": { "main": [[{ "node": "Build UGC Body", "type": "main", "index": 0 }]] },
    "Build UGC Body": { "main": [[{ "node": "Post to LinkedIn", "type": "main", "index": 0 }]] },
    "Post to LinkedIn": { "main": [[{ "node": "Check Result", "type": "main", "index": 0 }]] },
    "Check Result": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "saveManualExecutions": true }
}
